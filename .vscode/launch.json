	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Run wrangler",
			"runtimeExecutable": "wrangler",
			"cwd": "${workspaceFolder}",
			"args": ["pages", "dev"]
		},
		{
			"name": "Run Dev",
			"request": "launch",
			"runtimeArgs": ["run-script", "dev"],
			"runtimeExecutable": "npm",
			"skipFiles": ["<node_internals>/**"],
			"type": "node"
		}
	]
}
